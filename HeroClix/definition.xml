<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<game
    id="dabf7f85-249a-48ee-9d42-8f59adf60185"
    name="HeroClix"
	markersize="35"
    version="1.0.0.10"
    octgnVersion="3.1.0.2"
    scriptVersion="3.1.0.2"
	setsurl="http://www.TCGBuilder.net"
    gameurl="https://heroclix.com"
    authors="StormyWaters2021"
    description="HeroClix by WizKids"
    tags="heroclix"
	iconurl="https://www.tcgbuilder.net/games/heroclix/art/logo.jpg"
	>
  
  <scripts>
      <script src="Scripts/actions.py" />
	  <script src="Scripts/mapcontrols.py" />
	  <script src="Scripts/setup.py" />
	  <script src="Scripts/debug.py" />
	  <script src="Scripts/changelog.py" />
	  <script src="Scripts/hcu.py" />
	  <script src="Scripts/boards.py" />
  </scripts>
  
  <proxygen definitionsrc="Proxy/proxydef.xml"/>
  
  <globalvariables>
    <globalvariable name="players_loaded" value="0" /> 
  </globalvariables>
  
  <events>
    <event name="OnCardsMoved" action="table_config" />
	<!-- <event name="OnDeckLoaded" action="deck_loaded"/> -->
	<!-- <event name="OnGlobalVariableChanged" action="loaded_check"/> -->
	<!-- <event name="OnCardArrowTargeted" action="attach_card"/> -->
	<!-- <event name="OnGameStarted" action="game_started"/> -->
	<event name="OnTableLoaded" action="setup_table" />
  </events>
  
  <!-- Card Properties -->
<card back="Images/cardback.jpg" front="Images/cardback.jpg" width="185" height="250" cornerRadius="10" backCornerRadius="5">
	<!-- Visible Card Properties -->
    <property name="Unit Type" type="String" hidden="False"/>
    <property name="Rarity" type="String" hidden="False"/>
    <property name="Point Values" type="String" hidden="False"/>
    <property name="Team Abilities" type="String" hidden="False"/>
    <property name="Keywords" type="String" hidden="False"/>
    <property name="Traits and Special Powers" type="String" hidden="False"/>
    <property name="Combat Symbols" type="String" hidden="False"/>
	<property name="Properties" type="String" hidden="False"/>
	<property name="Improved Movement" type="String" hidden="False"/>
	<property name="Improved Targeting" type="String" hidden="False"/>
    <property name="Range" type="String" hidden="False"/>
    <property name="Targets" type="String" hidden="False"/>
	<property name="Collector Number" type="String" hidden="False"/>
	
	<!-- Hidden Card Properties -->
	<property name="Unit ID" type="String" hidden="True"/>
	<property name="Click Number" type="String" hidden="True"/>
	<property name="Set Code" type="String" hidden="True" />
    <property name="Starting Line" type="String" hidden="True"/>
    <property name="Speed" type="String" hidden="True"/>
    <property name="Speed Ability" type="String" hidden="True"/>
    <property name="Attack" type="String" hidden="True"/>
    <property name="Attack Ability" type="String" hidden="True"/>
    <property name="Defense" type="String" hidden="True"/>
    <property name="Defense Ability" type="String" hidden="True"/>
    <property name="Damage" type="String" hidden="True"/>
    <property name="Damage Ability" type="String" hidden="True"/>
    
	<!-- Card Sizes -->
	<size name="Card" width="371" height="250" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	
	<size name="1x1" width="100" height="100" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="0" backCornerRadius="0" />
	<size name="1x2" width="200" height="100" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="1x3" width="300" height="100" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="1x4" width="400" height="100" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="0" backCornerRadius="0" />
	
	<size name="2x2" width="200" height="200" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="2x3" width="300" height="200" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="0" backCornerRadius="0" />
	<size name="3x3" width="300" height="300" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="3x6" width="300" height="600" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
		
	<size name="16x8" width="1600" height="800" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="16x16" width="1600" height="1600" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="16x24" width="1600" height="2400" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	
	<size name="Dice" width="100" height="100" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />
	<size name="PAC" width="510" height="421" front="Images/cardback.jpg" back="Images/cardback.jpg" cornerRadius="5" backCornerRadius="5" />

</card>

<markers>
	<marker id="action_marker" name="Action" src="Images/action.png" />
</markers>

<phases />
  
<gameboards src="Images/playmat.png" x="-2300" y="-1600" width="4600" height="3200" >
	<gameboard name="DC Badges" src="Images/dc_badges.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	<gameboard name="JLA" src="Images/jla.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	<gameboard name="X-Men Collage" src="Images/xmen-collage.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	<gameboard name="Spiderweb" src="Images/spiderweb.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	<gameboard name="Avengers Collage" src="Images/avengers-collage.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	<gameboard name="Hulk and Hulkbuster" src="Images/hulk_and_buster.jpg" x="-2300" y="-1600" width="4600" height="3200" />
	
</gameboards>

<table name="Table" visibility="undefined" ordered="False" width="4600" height="3200" background="Images/table.jpg" backgroundStyle="uniform" >

	<!-- # ~~ DEBUG ~~ # -->
	<cardaction menu="Position" showIf="fail_check" shortcut="alt+a" execute="position" />
	<cardaction menu="Test" showIf="fail_check" shortcut="alt+t" execute="_test" />
	<!-- # ~~ DEBUG ~~ # -->
	<cardaction menu="Attack" showIf="is_not_map" execute="calculate_attack" />
	<cardaction menu="Rotate Map" showIf="is_map" execute="rotate_map" />
	<cardaction menu="Add Action Counter" showIf="is_not_map" default="True" execute="double_click" />
	<cardaction menu="Remove Action Counter" showIf="is_not_map" execute="remove_action" />
	<cardaction menu="Rotate Model" showIf="is_not_map" execute="rotate_model" />
	
	
	<cardseparator />
	<cardaction menu="Take 1 Damage" showIf="is_not_map" shortcut="Down" execute="take_one_damage" />
	<cardaction menu="Take X Damage" showIf="is_not_map" execute="take_x_damage" />
	<cardaction menu="Heal 1 Damage" showIf="is_not_map" shortcut="Up" execute="heal_one_damage" />
	<cardseparator />
	<cardaction menu="Flip Card Over" showIf="is_one_shot" execute="flip_card" />
	
	<groupactions menu="Dice">
		<groupaction menu="Roll Two Dice" shortcut="Ctrl+R" execute="roll_dice" />
		<groupaction menu="Roll Single Die" execute="roll_single_die" />
		<groupaction menu="Roll d20" execute="roll_d20" />
	</groupactions>

	<groupaction menu="Load Map" execute="load_map" />
	<groupaction menu="Load Team from HCUnits" execute="importHCUnits" />

	<groupactions menu="Generate...">
		<groupaction menu="Generate Bystander" execute="create_bystander" />
		<groupaction menu="Generate Terrain" execute="create_terrain" />
		<groupaction menu="Generate One Shot" execute="create_one_shot" />
	</groupactions>
	
	<groupactions menu="Swap Playmat">
		<groupaction menu="Default (Table)" execute="swap_board_default" />
		<groupaction menu="DC Badges" execute="swap_board_dc_badges" />
		<groupaction menu="JLA" execute="swap_board_jla" />
		<groupaction menu="X-Men Collage" execute="swap_board_xmen_collage" />
		<groupaction menu="Spiderweb" execute="swap_board_spiderweb" />
		<groupaction menu="Avengers Collage" execute="swap_board_avengers_collage" />
		<groupaction menu="Hulk and Hulkbuster" execute="swap_board_hulkbuster" />
	</groupactions>
	
</table>

<player summary="Team: {#Team}">

	<group name="Team" visibility="me" ordered="False" icon="Images/cards.png" viewState="expanded" />
	<group name="Sideline" visibility="me" ordered="False" icon="Images/cards.png" viewState="expanded" />
	<group name="Maps" visibility="me" ordered="True" viewState="pile" icon="Images/deck.png" />
	
</player>	
	
  <!-- Default Deck Sections -->
  <deck>
    <section name="Team" group="Team" />
	<section name="Sideline" group="Sideline" />
	<section name="Maps" group="Maps" />
  </deck>

</game>
